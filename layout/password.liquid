<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <style>
    @font-face{font-family:"Zalando Sans Expanded";src:url({{ 'zalando-sans-expanded.woff2' | asset_url }}) format("woff2");font-display:swap}
    @font-face{font-family:"Hanken Grotesk";src:url({{ 'hanken-grotesk.woff2' | asset_url }}) format("woff2");font-display:swap}
  </style>
  {{ 'farsea.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  {% render 'logo-symbol' %}
  <main id="main">{{ content_for_layout }}</main>
</body>
</html>
