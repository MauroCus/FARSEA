{%- liquid
  assign menu = linklists[section.settings.menu]
  assign book_link = section.settings.button_link | default: '/#contatti'
-%}
<header>
  <div class="bar wrap">
    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 300 | image_tag: alt: shop.name, style: 'width:132px;height:auto' }}
      {%- else -%}
        <svg role="img" aria-label="{{ shop.name }}" viewBox="0 0 113.1 27.6"><use href="#farsea"/></svg>
      {%- endif -%}
    </a>

    <nav class="main" aria-label="{{ 'general.menu' | t }}">
      {%- if menu.links.size > 0 -%}
        {%- for link in menu.links -%}
          <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}#esigenze">{{ 'nav.concerns' | t }}</a>
        <a href="{{ routes.root_url }}#soluzioni">{{ 'nav.treatments' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}"{% if template.name == 'collection' or template.name == 'product' %} aria-current="page"{% endif %}>{{ 'nav.shop' | t }}</a>
        <a href="{{ routes.root_url }}#approccio">{{ 'nav.about' | t }}</a>
        <a href="{{ routes.root_url }}#contatti">{{ 'nav.contact' | t }}</a>
      {%- endif -%}
    </nav>

    <div class="bar-end">
      {%- if section.settings.show_language and localization.available_languages.size > 1 -%}
        <div class="lang">
          {%- form 'localization', id: 'HeaderLanguage' -%}
            {%- for language in localization.available_languages -%}
              {%- unless forloop.first -%}<span aria-hidden="true">/</span>{%- endunless -%}
              <button type="submit" name="language_code" value="{{ language.iso_code }}" lang="{{ language.iso_code }}" aria-pressed="{% if language.iso_code == localization.language.iso_code %}true{% else %}false{% endif %}" title="{{ language.endonym_name | capitalize }}">
                {%- case language.iso_code -%}
                  {%- when 'en' -%}ENG
                  {%- when 'it' -%}ITA
                  {%- else -%}{{ language.iso_code | upcase }}
                {%- endcase -%}
              </button>
            {%- endfor -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a class="btn btn-ink book-btn" href="{{ book_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}

      <a class="bag-btn" href="{{ routes.cart_url }}" data-open-cart aria-haspopup="dialog">
        <span class="bag-label">{{ 'header.bag' | t }}</span>
        <span class="bag-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
      <button class="menu-btn" id="openMenu" aria-expanded="false" aria-controls="menu">{{ 'general.menu' | t }}</button>
    </div>
  </div>
</header>

<div class="overlay wrap" id="menu" hidden>
  <div class="top">
    <span class="logo"><svg role="img" aria-label="{{ shop.name }}" viewBox="0 0 113.1 27.6"><use href="#farsea"/></svg></span>
    <button class="close" id="closeMenu">{{ 'general.close' | t }}</button>
  </div>
  <ol>
    <li><a href="{{ routes.root_url }}"><small>01</small>{{ 'general.home' | t }}</a></li>
    {%- if menu.links.size > 0 -%}
      {%- for link in menu.links -%}
        <li><a href="{{ link.url }}"><small>{{ forloop.index | plus: 1 | prepend: '0' | slice: -2, 2 }}</small>{{ link.title }}</a></li>
      {%- endfor -%}
    {%- else -%}
      <li><a href="{{ routes.root_url }}#esigenze"><small>02</small>{{ 'nav.concerns' | t }}</a></li>
      <li><a href="{{ routes.root_url }}#soluzioni"><small>03</small>{{ 'nav.treatments' | t }}</a></li>
      <li><a href="{{ routes.all_products_collection_url }}"><small>04</small>{{ 'nav.shop' | t }}</a></li>
      <li><a href="{{ routes.root_url }}#approccio"><small>05</small>{{ 'nav.about' | t }}</a></li>
      <li><a href="{{ routes.root_url }}#contatti"><small>06</small>{{ 'nav.contact' | t }}</a></li>
    {%- endif -%}
  </ol>
  <div class="contact-mini">
    <span>{{ settings.address }}</span>
    <span>{{ settings.email }} · {{ settings.phone }}</span>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Leave empty to use the FARSEA wordmark." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "If the menu is empty, the theme shows Concerns, Treatments, Shop, About and Contact." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Book a visit" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "/#contatti", "info": "A page address, a booking link, or /#contatti for the contact section." },
    { "type": "checkbox", "id": "show_language", "label": "Show ENG / ITA switch", "default": true }
  ]
}
{% endschema %}
