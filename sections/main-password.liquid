<section class="wrap" style="min-height:70vh;display:grid;place-items:center;text-align:center">
  <div style="display:grid;gap:22px;justify-items:center">
    <svg viewBox="0 0 113.1 27.6" style="width:200px" role="img" aria-label="{{ shop.name }}"><use href="#farsea"/></svg>
    <h1 style="font-size:clamp(26px,3vw,40px)">{{ 'general.password_title' | t }}</h1>
    {%- if shop.password_message != blank -%}<p style="color:var(--mute);max-width:44ch;margin:0">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <div class="search-form" style="margin:0">
        <label class="vh" for="pw">{{ 'general.password_enter' | t }}</label>
        <input id="pw" type="password" name="password" placeholder="{{ 'general.password_enter' | t }}" autocomplete="current-password">
        <button class="btn btn-ink" type="submit">{{ 'general.password_submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
