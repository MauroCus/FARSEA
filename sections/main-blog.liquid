<section class="wrap">
  <div class="page-wrap">
    <h1>{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      {%- for article in blog.articles -%}
        <article style="padding-block:20px;border-bottom:1px solid var(--line)">
          <h2 style="font-size:24px"><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p style="color:var(--mute);margin:8px 0 0">{{ article.excerpt_or_content | strip_html | truncate: 180 }}</p>
        </article>
      {%- endfor -%}
      {%- if paginate.pages > 1 -%}<div style="margin-top:24px">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
