<div class="trust wrap">
  {%- for block in section.blocks -%}
    <div {{ block.shopify_attributes }}>
      {%- case block.settings.icon -%}
        {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>
        {%- when 'doctor' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="9"/></svg>
        {%- when 'returns' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 12a8 8 0 1 0 3-6.2M4 4v4h4"/></svg>
        {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
      {%- endcase -%}
      <span>{{ block.settings.text }}</span>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Trust bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "truck", "label": "Shipping" },
          { "value": "doctor", "label": "Doctors" },
          { "value": "returns", "label": "Returns" },
          { "value": "lock", "label": "Secure payment" }
        ] },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over €70" }
      ]
    }
  ],
  "presets": [{ "name": "Trust bar" }]
}
{% endschema %}
