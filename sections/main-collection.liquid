{%- liquid
  assign kit = section.settings.kit
  assign kit_at = section.settings.kit_position
-%}
<section id="shop" class="wrap" data-collection>
  <div class="head">
    <h2>{{ section.settings.heading | default: collection.title }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- elsif collection.description != blank -%}<div class="rte" style="max-width:42ch;color:var(--mute)">{{ collection.description }}</div>{%- endif -%}
  </div>

  <div class="toolbar">
    <div class="chips" role="group" aria-label="{{ 'collection.filter_label' | t }}">
      <button type="button" class="chip" data-filter="all" aria-pressed="true">{{ 'collection.all' | t }}</button>
      {%- for block in section.blocks -%}
        <button type="button" class="chip" data-filter="{{ block.settings.tag | downcase | strip | escape }}" aria-pressed="false" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
      {%- endfor -%}
    </div>
    <div class="tool-end">
      <span class="tool-count" data-count data-one="{{ 'collection.count.one' | t: count: 1 }}" data-other="{{ 'collection.count.other' | t: count: '#N#' }}">{{ 'collection.count' | t: count: collection.products_count }}</span>
      <label for="sort-{{ section.id }}" class="vh">{{ 'collection.sort_label' | t }}</label>
      <select id="sort-{{ section.id }}" data-sort>
        <option value="featured">{{ 'collection.sort_featured' | t }}</option>
        <option value="asc">{{ 'collection.sort_asc' | t }}</option>
        <option value="desc">{{ 'collection.sort_desc' | t }}</option>
      </select>
    </div>
  </div>

  {%- paginate collection.products by 48 -%}
  <div class="p-grid" data-grid>
    {%- for product in collection.products -%}
      {%- if kit != blank and product.id == kit.id -%}{%- continue -%}{%- endif -%}
      {% render 'product-card', product: product, index: forloop.index %}
      {%- if kit != blank and forloop.index == kit_at -%}{% render 'kit-tile', kit: kit, desktop_at: kit_at %}{%- endif -%}
    {%- else -%}
      <p class="empty">{{ 'collection.empty' | t }}</p>
    {%- endfor -%}
    {%- if kit != blank and collection.products_count < kit_at -%}{% render 'kit-tile', kit: kit, desktop_at: kit_at %}{%- endif -%}
    <p class="empty" data-empty hidden>{{ 'collection.empty' | t }}</p>
  </div>
  {%- if paginate.pages > 1 -%}<div style="margin-top:32px;text-align:center">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The range" },
    { "type": "text", "id": "text", "label": "Text", "default": "Seven essentials, each linked to the treatments it supports." },
    { "type": "product", "id": "kit", "label": "Kit product (wide tile)", "info": "The kit is shown as a wide dark tile instead of a normal card." },
    { "type": "range", "id": "kit_position", "label": "Show the kit after product number", "min": 1, "max": 12, "step": 1, "default": 3 }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filter chip",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Daily essentials" },
        { "type": "text", "id": "tag", "label": "Product tag", "default": "line:daily", "info": "Products with this tag are shown when the chip is selected." }
      ]
    }
  ]
}
{% endschema %}
